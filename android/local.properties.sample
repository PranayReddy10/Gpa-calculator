# Copy these lines into android/local.properties (Android Studio already created that file with sdk.dir).
# local.properties is ignored by git, so your keys never get committed.
# After editing: File > Sync Project with Gradle Files, then Build > Rebuild Project.

# Where backend/ is deployed (keep the trailing slash). This is already the default.
API_BASE_URL=https://gpa.jntubooks.in/
# Must be exactly the same as APP_API_KEY in backend/config.php
APP_API_KEY=paste-the-same-random-value-here
# AdMob app ID from AdMob > Apps > App settings (has a ~, not a /). Remove the # only when you
# paste your real ID; until then Google's test ID is used automatically.
#ADMOB_APP_ID=ca-app-pub-1234567890123456~1234567890
# Optional: AppLovin MAX SDK key. Leave empty to turn MAX off.
APPLOVIN_SDK_KEY=
# Optional: OneSignal app ID (can also be set in the admin panel App tab)
ONESIGNAL_APP_ID=

# ---------------- Release (Google Play) ----------------
# Must be higher than the version code currently live on Play (Play Console > App bundle explorer)
VERSION_CODE=100
VERSION_NAME=2.0.0
# Signing: easiest is Android Studio > Build > Generate Signed App Bundle (pick your .jks there;
# leave these out). For command-line builds (./gradlew bundleRelease) set them instead.
# Use the SAME key as the version live on Play (upload key if Play App Signing is on).
#RELEASE_STORE_FILE=/path/to/your-upload-key.jks
#RELEASE_STORE_PASSWORD=
#RELEASE_KEY_ALIAS=
#RELEASE_KEY_PASSWORD=
